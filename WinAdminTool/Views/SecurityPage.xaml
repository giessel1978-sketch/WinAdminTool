<Page
    x:Class="WinAdminTool.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid Padding="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Überschrift -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Text="Sicherheit"
                    FontSize="28"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Status der wichtigsten Windows-Sicherheitsfunktionen"
                    Margin="0,4,0,0"
                    Opacity="0.7"/>

            </StackPanel>


            <!-- Statuskarten -->

            <Grid
                Grid.Row="1"
                Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Defender -->

                <Border
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>

                        <TextBlock
                            Text="Microsoft Defender"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="DefenderStatusTextBlock"
                            Text="Wird ermittelt..."
                            FontSize="16"
                            Margin="0,12,0,0"/>

                        <TextBlock
                            x:Name="DefenderDetailsTextBlock"
                            Text="-"
                            Margin="0,4,0,0"
                            Opacity="0.7"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- Firewall -->

                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>

                        <TextBlock
                            Text="Windows-Firewall"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="FirewallStatusTextBlock"
                            Text="Wird ermittelt..."
                            FontSize="16"
                            Margin="0,12,0,0"/>

                        <TextBlock
                            x:Name="FirewallDetailsTextBlock"
                            Text="-"
                            Margin="0,4,0,0"
                            Opacity="0.7"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- Sicherheitsfunktionen -->

                <Border
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>

                        <TextBlock
                            Text="Windows-Sicherheit"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="WindowsSecurityStatusTextBlock"
                            Text="Wird ermittelt..."
                            FontSize="16"
                            Margin="0,12,0,0"/>

                        <TextBlock
                            x:Name="WindowsSecurityDetailsTextBlock"
                            Text="-"
                            Margin="0,4,0,0"
                            Opacity="0.7"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- Details -->

            <Border
                Grid.Row="2"
                Margin="0,16,0,0"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock
                        Grid.Row="0"
                        Text="Sicherheitsdetails"
                        FontSize="20"
                        FontWeight="SemiBold"/>


                    <!-- Defender Echtzeitschutz -->

                    <Grid
                        Grid.Row="1"
                        Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Echtzeitschutz"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="RealTimeProtectionTextBlock"
                            Grid.Column="1"
                            Text="-"/>

                    </Grid>


                    <!-- Antivirus -->

                    <Grid
                        Grid.Row="2"
                        Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Antivirenschutz"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="AntivirusTextBlock"
                            Grid.Column="1"
                            Text="-"/>

                    </Grid>


                    <!-- Letzter Scan -->

                    <Grid
                        Grid.Row="3"
                        Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Letzter Scan"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="LastScanTextBlock"
                            Grid.Column="1"
                            Text="-"/>

                    </Grid>


                    <!-- Defender Signaturen -->

                    <Grid
                        Grid.Row="4"
                        Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Signaturversion"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="SignatureVersionTextBlock"
                            Grid.Column="1"
                            Text="-"/>

                    </Grid>


                    <!-- Firewall Domäne -->

                    <Grid
                        Grid.Row="5"
                        Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Firewall – Domäne"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="FirewallDomainTextBlock"
                            Grid.Column="1"
                            Text="-"/>

                    </Grid>


                    <!-- Firewall Privat -->

                    <Grid
                        Grid.Row="6"
                        Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Firewall – Privat"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="FirewallPrivateTextBlock"
                            Grid.Column="1"
                            Text="-"/>

                    </Grid>


                    <!-- Firewall Öffentlich -->

                    <Grid
                        Grid.Row="7"
                        Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Firewall – Öffentlich"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="FirewallPublicTextBlock"
                            Grid.Column="1"
                            Text="-"/>

                    </Grid>


                    <!-- UAC / Secure Boot / TPM -->

                    <Grid
                        Grid.Row="8"
                        Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Systemschutz"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="SystemProtectionTextBlock"
                            Grid.Column="1"
                            Text="-"
                            TextWrapping="Wrap"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>