<Page
    x:Class="WinAdminTool.Views.BluetoothPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Padding="24"
            Spacing="16">

            <!-- ===================================================== -->
            <!-- Kopfbereich -->
            <!-- ===================================================== -->

            <StackPanel Spacing="4">

                <TextBlock
                    Text="Bluetooth"
                    FontSize="32"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Bluetooth-Adapter und verbundene Geräte anzeigen"
                    Opacity="0.7"
                    FontSize="14" />

            </StackPanel>


            <!-- ===================================================== -->
            <!-- Bluetooth-Adapter -->
            <!-- ===================================================== -->

            <Border
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="Bluetooth-Adapter"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Adapter"
                            Opacity="0.7" />

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Name="AdapterName"
                            Text="Nicht ermittelt" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Hersteller"
                            Opacity="0.7"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="AdapterManufacturer"
                            Text="Nicht ermittelt"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Status"
                            Opacity="0.7"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="AdapterStatus"
                            Text="Nicht ermittelt"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Geräte-ID"
                            Opacity="0.7"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            x:Name="AdapterDeviceId"
                            Text="Nicht ermittelt"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,8,0,0" />

                    </Grid>

                </StackPanel>

            </Border>


            <!-- ===================================================== -->
            <!-- Bluetooth-Geräte -->
            <!-- ===================================================== -->

            <Border
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="Bluetooth-Geräte"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <ListView
                        x:Name="BluetoothDevicesList"
                        SelectionMode="Single"
                        SelectionChanged="BluetoothDevicesList_SelectionChanged">

                        <ListView.ItemTemplate>
                            <DataTemplate>

                                <Grid Padding="8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="3">

                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="{Binding DeviceType}"
                                            Opacity="0.6"
                                            FontSize="13" />

                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding ConnectionStatus}"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding PairingStatus}"
                                        VerticalAlignment="Center" />

                                </Grid>

                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                    <TextBlock
                        x:Name="BluetoothDevicesStatus"
                        Text="Geräte werden ermittelt …"
                        Opacity="0.7" />

                </StackPanel>

            </Border>


            <!-- ===================================================== -->
            <!-- Gerätedetails -->
            <!-- ===================================================== -->

            <Border
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="Gerätedetails"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Name"
                            Opacity="0.7" />

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Name="DetailName"
                            Text="Kein Gerät ausgewählt" />


                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Typ"
                            Opacity="0.7"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="DetailType"
                            Text="—"
                            Margin="0,8,0,0" />


                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Verbindung"
                            Opacity="0.7"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="DetailConnection"
                            Text="—"
                            Margin="0,8,0,0" />


                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Kopplung"
                            Opacity="0.7"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            x:Name="DetailPairing"
                            Text="—"
                            Margin="0,8,0,0" />


                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Text="Geräte-ID"
                            Opacity="0.7"
                            Margin="0,8,0,0" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            x:Name="DetailDeviceId"
                            Text="—"
                            TextWrapping="Wrap"
                            Margin="0,8,0,0" />

                    </Grid>

                </StackPanel>

            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>