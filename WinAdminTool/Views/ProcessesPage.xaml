<Page
    x:Class="WinAdminTool.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Überschrift -->
        <StackPanel Grid.Row="0">

            <TextBlock
                Text="Prozesse"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Laufende Windows-Prozesse und Ressourcenverbrauch"
                FontSize="14"
                Opacity="0.7"
                Margin="0,4,0,0"/>

            <TextBlock
                x:Name="ProcessCountText"
                Text="0 Prozesse aktiv"
                FontSize="13"
                Opacity="0.6"
                Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Suchfeld -->
        <Grid
            Grid.Row="1"
            Margin="0,20,0,16">

            <TextBox
                x:Name="ProcessSearchBox"
                PlaceholderText="Prozess suchen..."
                Width="320"
                HorizontalAlignment="Left"
                TextChanged="ProcessSearchBox_TextChanged"/>

        </Grid>

        <!-- Tabellenkopf -->
        <Border
            Grid.Row="2"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Prozess"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Grid.Column="1"
                    Text="PID"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Grid.Column="2"
                    Text="CPU"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Grid.Column="3"
                    Text="Arbeitsspeicher"
                    FontWeight="SemiBold"/>

            </Grid>

        </Border>

        <!-- Prozessliste -->
        <ListView
            x:Name="ProcessListView"
            Grid.Row="3"
            SelectionMode="Single">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Grid Padding="12,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{Binding Name}"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Id}"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding CpuDisplay}"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="{Binding MemoryDisplay}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Page>