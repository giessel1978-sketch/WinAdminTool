 <Page
    x:Class="WinAdminTool.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Überschrift -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="Ereignisse"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Windows-Ereignisprotokolle anzeigen und durchsuchen"
                Margin="0,4,0,0"
                Opacity="0.7"/>

        </StackPanel>


        <!-- Filter -->

        <Grid
            Grid.Row="1"
            Margin="0,20,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="LogComboBox"
                Grid.Column="0"
                Header="Protokoll"
                SelectedIndex="0"
                Margin="0,0,12,0"
                SelectionChanged="LogComboBox_SelectionChanged">

                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Application"/>
                <ComboBoxItem Content="Security"/>

            </ComboBox>

            <ComboBox
                x:Name="LevelComboBox"
                Grid.Column="1"
                Header="Ebene"
                SelectedIndex="0"
                Margin="0,0,12,0"
                SelectionChanged="LevelComboBox_SelectionChanged">

                <ComboBoxItem Content="Alle"/>
                <ComboBoxItem Content="Information"/>
                <ComboBoxItem Content="Warnung"/>
                <ComboBoxItem Content="Fehler"/>
                <ComboBoxItem Content="Kritisch"/>

            </ComboBox>

            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="2"
                Header="Suche"
                PlaceholderText="Quelle, Ereignis-ID oder Text..."
                Margin="0,0,12,0"
                TextChanged="SearchTextBox_TextChanged"/>

            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                Content="Aktualisieren"
                VerticalAlignment="Bottom"
                Click="RefreshButton_Click"/>

        </Grid>


        <!-- Ereignisliste + Details -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>


            <!-- Ereignisliste -->

            <Border
                Grid.Column="0"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Spaltenüberschriften -->

                    <Border
                        Grid.Row="0"
                        Padding="10,8"
                        BorderThickness="0,0,0,1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Zeitpunkt"
                                FontWeight="SemiBold"
                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Ebene"
                                FontWeight="SemiBold"
                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="Quelle"
                                FontWeight="SemiBold"
                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="ID"
                                FontWeight="SemiBold"
                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="4"
                                Text="Meldung"
                                FontWeight="SemiBold"
                                FontSize="12"/>

                        </Grid>

                    </Border>


                    <!-- Ereignisse -->

                    <ListView
                        x:Name="EventsListView"
                        Grid.Row="1"
                        SelectionChanged="EventsListView_SelectionChanged">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Grid Padding="10,6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding TimeCreated}"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Level}"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding ProviderName}"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Id}"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding Message}"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"/>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>


            <!-- Details -->

            <Border
                Grid.Column="1"
                Margin="16,0,0,0"
                Padding="20"
                BorderThickness="1"
                CornerRadius="8">

                <ScrollViewer>

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Ereignisdetails"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="DetailPlaceholder"
                            Text="Wählen Sie ein Ereignis aus."
                            Opacity="0.7"
                            FontSize="13"/>

                        <TextBlock
                            x:Name="DetailTextBlock"
                            TextWrapping="Wrap"
                            FontSize="13"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</Page>
