 <Page
    x:Class="WinAdminTool.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid Padding="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Überschrift -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Text="Werkzeuge"
                    FontSize="28"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Windows-Werkzeuge, Diagnose und Wartung zentral verwalten"
                    Margin="0,4,0,0"
                    Opacity="0.7"/>

            </StackPanel>


            <!-- Windows-Werkzeuge -->

            <StackPanel
                Grid.Row="1"
                Margin="0,24,0,0">

                <TextBlock
                    Text="Windows-Werkzeuge"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>


                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Geräte-Manager"
                        Click="DeviceManagerButton_Click"/>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Computerverwaltung"
                        Click="ComputerManagementButton_Click"/>


                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Datenträgerverwaltung"
                        Click="DiskManagementButton_Click"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Systeminformationen"
                        Click="SystemInformationButton_Click"/>


                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Content="Task-Manager"
                        Click="TaskManagerButton_Click"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Content="Ereignisanzeige"
                        Click="EventViewerButton_Click"/>

                </Grid>

            </StackPanel>


            <!-- Kommandozeile & Netzwerk -->

            <StackPanel
                Grid.Row="2"
                Margin="0,20,0,0">

                <TextBlock
                    Text="Kommandozeile &amp; Netzwerk"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>


                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Eingabeaufforderung"
                        Click="CommandPromptButton_Click"/>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="PowerShell"
                        Click="PowerShellButton_Click"/>


                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Windows Terminal"
                        Click="WindowsTerminalButton_Click"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Netzwerkdiagnose"
                        Click="NetworkDiagnosticsButton_Click"/>


                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="DNS-Cache leeren"
                        Click="FlushDnsButton_Click"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="IP-Adresse erneuern"
                        Click="RenewIpAddressButton_Click"/>


                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Winsock zurücksetzen"
                        Click="ResetWinsockButton_Click"/>

                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="TCP/IP zurücksetzen"
                        Click="ResetTcpIpButton_Click"/>


                    <Button
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="IP-Konfiguration"
                        Click="IpConfigButton_Click"/>

                    <Button
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Ping"
                        Click="PingButton_Click"/>


                    <Button
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="DNS-Auflösung"
                        Click="NslookupButton_Click"/>

                    <Button
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Routing-Tabelle"
                        Click="RouteButton_Click"/>


                    <Button
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Content="ARP-Tabelle"
                        Click="ArpButton_Click"/>

                    <Button
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Content="Netstat"
                        Click="NetstatButton_Click"/>

                </Grid>

            </StackPanel>


            <!-- System & Verwaltung -->

            <StackPanel
                Grid.Row="3"
                Margin="0,20,0,0">

                <TextBlock
                    Text="System &amp; Verwaltung"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>


                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Diensteverwaltung"
                        Click="ServicesManagementButton_Click"/>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Systemkonfiguration"
                        Click="SystemConfigurationButton_Click"/>


                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Registry-Editor"
                        Click="RegistryEditorButton_Click"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Lokale Benutzer"
                        Click="LocalUsersButton_Click"/>


                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Systemwiederherstellung"
                        Click="SystemRestoreButton_Click"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Lokale Sicherheitsrichtlinie"
                        Click="LocalSecurityPolicyButton_Click"/>


                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Content="Gruppenrichtlinien"
                        Click="GroupPolicyButton_Click"/>

                </Grid>

            </StackPanel>


            <!-- Wartung & Reparatur -->

            <StackPanel
                Grid.Row="4"
                Margin="0,20,0,0">

                <TextBlock
                    Text="Wartung &amp; Reparatur"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>


                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Systemdateiprüfung (SFC)"
                        Click="SfcButton_Click"/>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="DISM – Status prüfen"
                        Click="DismCheckHealthButton_Click"/>


                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="DISM – Scan durchführen"
                        Click="DismScanHealthButton_Click"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="DISM – Reparieren"
                        Click="DismRestoreHealthButton_Click"/>


                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Content="CHKDSK"
                        Click="ChkdskButton_Click"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Content="Windows Update"
                        Click="WindowsUpdateButton_Click"/>


                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Content="Komponentenstore prüfen"
                        Click="AnalyzeComponentStoreButton_Click"/>

                </Grid>

            </StackPanel>


            <!-- Schnellzugriff -->

            <StackPanel
                Grid.Row="5"
                Margin="0,20,0,0">

                <TextBlock
                    Text="Schnellzugriff"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>


                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="Benutzer-Temp öffnen"
                        Click="UserTempButton_Click"/>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Windows-Temp öffnen"
                        Click="WindowsTempButton_Click"/>


                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,4,4"
                        Content="SoftwareDistribution öffnen"
                        Click="SoftwareDistributionButton_Click"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,0,0,4"
                        Content="Hosts-Datei öffnen"
                        Click="HostsFileButton_Click"/>


                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Content="System32 öffnen"
                        Click="System32Button_Click"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Content="Windows-Ordner öffnen"
                        Click="WindowsFolderButton_Click"/>

                </Grid>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>
