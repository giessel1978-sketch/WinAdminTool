<Page
    x:Class="WinAdminTool.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->
        <Grid Grid.Row="0" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="Dienste"
                    FontSize="28"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Windows-Dienste verwalten und überwachen"
                    Margin="0,4,0,0"
                    Opacity="0.7"/>
            </StackPanel>

            <Button
                Grid.Column="1"
                Content="⟳  Aktualisieren"
                Padding="16,8"
                VerticalAlignment="Center"
                Click="RefreshButton_Click"/>
        </Grid>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="🔍  Dienst suchen..."
                Margin="0,0,12,0"
                TextChanged="SearchBox_TextChanged"/>

            <ComboBox
                x:Name="StatusFilter"
                Grid.Column="1"
                Header="Status"
                Margin="0,0,12,0"
                SelectionChanged="Filter_SelectionChanged">

                <ComboBoxItem Content="Alle"/>
                <ComboBoxItem Content="Wird ausgeführt"/>
                <ComboBoxItem Content="Beendet"/>

            </ComboBox>

            <ComboBox
                x:Name="StartTypeFilter"
                Grid.Column="2"
                Header="Starttyp"
                SelectionChanged="Filter_SelectionChanged">

                <ComboBoxItem Content="Alle"/>
                <ComboBoxItem Content="Automatisch"/>
                <ComboBoxItem Content="Manuell"/>
                <ComboBoxItem Content="Deaktiviert"/>

            </ComboBox>

        </Grid>

        <!-- Hauptbereich -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Dienstliste -->
            <Border
                Grid.Column="0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,12,0">

                <ListView
                    x:Name="ServicesList"
                    ItemsSource="{x:Bind FilteredServices}"
                    SelectionChanged="ServicesList_SelectionChanged"
                    IsItemClickEnabled="False">

                    <ListView.Header>

                        <Grid Padding="8,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Name"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Anzeigename"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="Status"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="Starttyp"
                                FontWeight="SemiBold"/>

                        </Grid>

                    </ListView.Header>

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Grid Padding="8,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Status}"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding StartType}"/>

                            </Grid>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Border>

            <!-- Detailbereich -->
            <Border
                Grid.Column="1"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="Dienstinformationen"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,20"/>

                    <TextBlock
                        x:Name="SelectedServiceName"
                        Text="Kein Dienst ausgewählt"
                        FontSize="16"
                        Margin="0,0,0,16"/>

                    <StackPanel
                        x:Name="ServiceDetailsPanel"
                        Visibility="Collapsed"
                        Spacing="10">

                        <TextBlock
                            x:Name="SelectedServiceDisplayName"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            x:Name="SelectedServiceStatus"/>

                        <TextBlock
                            x:Name="SelectedServiceStartType"/>

                        <TextBlock
                            x:Name="SelectedServiceStartName"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            x:Name="SelectedServiceDescription"
                            TextWrapping="Wrap"
                            Margin="0,8,0,0"/>

                        <TextBlock
                            x:Name="SelectedServicePath"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                    <TextBlock
                        x:Name="NoSelectionText"
                        Text="Wähle einen Dienst aus der Liste aus, um weitere Informationen anzuzeigen."
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        Margin="0,0,0,24"/>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <Button
                        x:Name="StartButton"
                        Content="▶  Starten"
                        IsEnabled="False"
                        Click="StartButton_Click"/>

                        <Button
                        x:Name="StopButton"
                        Content="■  Stoppen"
                        IsEnabled="False"
                        Click="StopButton_Click"/>

                        <Button
                        x:Name="RestartButton"
                        Content="⟳  Neustarten"
                        IsEnabled="False"
                        Click="RestartButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>